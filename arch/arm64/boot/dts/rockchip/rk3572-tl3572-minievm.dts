/* CSI#1：csi2_dphy0 (DPHY0 full mode, 4-lane) —— OV13855 @ CSI1
 * 默认关闭，由 overlay (rk3572-tl3572-minievm-camera-csi1.dtso) 打开
 */
&csi2_dphy0 {
	status = "disabled";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_in_ov13855_csi1: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&ov13855_csi1_out0>;
				data-lanes = <1 2 3 4>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi0_csi2_input>;
			};
		};
	};
};

&csi2_dphy0_hw {
	status = "disabled";
};

&csi2_dphy1_hw {
	status = "disabled";
};

/* CSI#2：csi2_dphy3 (DPHY1 full mode, 4-lane) —— OV13855 @ CSI2
 * 默认关闭，由 overlay (rk3572-tl3572-minievm-camera-csi2.dtso) 打开
 */
&csi2_dphy3 {
	status = "disabled";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_in_ov13855_csi2: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&ov13855_csi2_out0>;
				data-lanes = <1 2 3 4>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy3_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi2_csi2_input>;
			};
		};
	};
};

