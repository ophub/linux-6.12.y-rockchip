/* MIPI DSI：TL070MIPI (AML070WXBI4006)，4-lane，800x1280
 * 默认关闭，由 overlay (rk3572-tl3572-minievm-dsi800x1280-touch-*.dtso) 打开
 */
&dsi {
	status = "disabled";
	//rockchip,lane-rate = <1000>;

	dsi_panel: panel@0 {
		status = "okay";
		compatible = "simple-panel-dsi";
		reg = <0>;
		backlight = <&backlight>;
		reset-gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;	/* GPIO0_B4: MIPI_DSI_RST_L */
		//enable-gpios = <&gpio2 RK_PB7 GPIO_ACTIVE_HIGH>;
		power-supply = <&vcc3v3_lcd>;
		/* Fix "Expected bpc in {6,8} but got: 0" warning */
		bpc = <8>;
		reset-delay-ms = <60>;
		enable-delay-ms = <60>;
		prepare-delay-ms = <60>;
		unprepare-delay-ms = <60>;
		disable-delay-ms = <60>;
		width-mm = <68>;
		height-mm = <121>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
			      MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET)>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes  = <4>;
		panel-init-sequence = [
			05 1E 01 01
			23 00 02 EE 50
			29 00 03 EA 85 55
			23 00 02 30 00
			23 00 02 31 00
			29 00 03 90 50 15
			23 00 02 24 20
			23 00 02 99 00
			23 00 02 79 00
			23 00 02 95 74
			23 00 02 7A 20
			23 00 02 97 09
			23 00 02 7D 08
			23 00 02 56 83
			23 00 02 EE 60
			23 00 02 30 01
			23 00 02 27 22
			23 00 02 3A 24
			23 00 02 3B 00
			23 00 02 3C 1A
			23 00 02 3D 11
			23 00 02 3E 93
			23 00 02 42 64
			23 00 02 43 64
			23 00 02 44 0B
			23 00 02 46 4E
			23 00 02 8B 90
			23 00 02 8D 45
			23 00 02 91 11
			23 00 02 92 11
			23 00 02 93 9F
			23 00 02 9A 00
			23 00 02 9C 80
			29 00 06 47 0F 24 2C 39 36
			29 00 06 5A 0F 24 2C 39 36
			29 00 06 4C 4A 40 51 31 2F
			29 00 06 51 2D 10 25 1F 30
			29 00 05 56 37 46 5B 7F
			29 00 05 69 37 46 5B 7F
			23 00 02 EE 70
			29 00 05 00 03 07 00 01
			29 00 05 04 08 0C 55 01
			29 00 03 0C 05 3D
			29 00 06 10 05 08 00 01 05
			29 00 06 15 00 15 0D 08 00
			29 00 03 29 05 3D
			29 00 06 60 3C 3C 07 05 17
			29 00 06 65 15 13 11 01 03
			29 00 06 6A 3C 3C 3C 3C 3C
			29 00 06 6F 3C 3C 3C 3C 3C
			29 00 03 74 3C 3C
			29 00 06 80 3C 3C 06 04 16
			29 00 06 85 14 12 10 00 02
			29 00 06 8A 3C 3C 3C 3C 3C
			29 00 06 8F 3C 3C 3C 3C 3C
			29 00 03 94 3C 3C
			29 00 03 EA 00 00
			23 00 02 EE 00
			05 78 01 11
			05 1E 01 29
		];

		panel-exit-sequence = [
			05 00 01 28
			05 00 01 10
		];

		disp_timings0: display-timings {
			native-mode = <&dsi_timing0>;
			dsi_timing0: timing0 {
				clock-frequency = <67200000>;
				hactive = <800>;
				vactive = <1280>;
				hfront-porch = <80>;
				hsync-len = <20>;
				hback-porch = <20>;
				vfront-porch = <15>;
				vsync-len = <6>;
				vback-porch = <8>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <1>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel_in_dsi: endpoint {
					remote-endpoint = <&dsi_out_panel>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};
};

/* DSI 输出接 VP1，默认关闭，由 overlay 打开 */
&dsi_in_vp1 {
	status = "disabled";
};

&gmac0 {
	clock_in_out = "output";

	phy-handle = <&rgmii_phy_0>;
	phy-mode = "rgmii-rxid";

	label = "eth0";

	pinctrl-names = "default";
	pinctrl-0 = <&eth0_miim_pins
		     &eth0_tx_bus2_pins
		     &eth0_rx_bus2_pins
		     &eth0_rgmii_bus_pins
		     &eth0_rgmii_clk_pins>;

	tx_delay = <0x26>;
	/* rx_delay = <0x3f>; */

	status = "okay";
};

&gmac1 {
	clock_in_out = "output";

	phy-handle = <&rgmii_phy_1>;
	phy-mode = "rgmii-rxid";

	label = "eth1";

	pinctrl-names = "default";
	pinctrl-0 = <&eth1m1_miim_pins
		     &eth1m1_tx_bus2_pins
		     &eth1m1_rx_bus2_pins
		     &eth1m1_rgmii_clk_pins
