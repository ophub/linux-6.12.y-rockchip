/* HDMI OUT：使能脚 GPIO0_D1 (HDMI_TX_ON_H)，HPD 走 HDMI_TX0 (GPIO4_B1) */
&hdmi {
	enable-gpios = <&gpio0 RK_PD1 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&hdmi_txm0_hpdin_pins
		     &hdmi_txm0_ddc_pins
		     &hdmi_txm0_cec_pins>;
	status = "okay";
};

&hdmi_in_vp0 {
	status = "okay";
};

&hdptxphy {
	status = "okay";
};

/*
 * I2C1(m0)：
 *  - HUSB311 USB PD 控制器 (0x4e)
 *  - OV13855 摄像头 @ CSI1 (J15, 0x10)
 */
&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m0_xfer_pins>;

	usbc0: husb311@4e {
		compatible = "hynetek,husb311";
		reg = <0x4e>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PB0 IRQ_TYPE_LEVEL_LOW>;	/* GPIO2_B0: USB_OTG_INTn */
		pinctrl-names = "default";
		pinctrl-0 = <&usbc0_int>;
		vbus-supply = <&vbus5v0_typec>;
		status = "okay";

		usb_con0: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			op-sink-microwatt = <1000000>;
			orientation-switch = <&usb3_switch &u2phy0>;
			usb-role-switch = <&usb_drd0_dwc3>;

			sink-pdos = <PDO_FIXED(5000, 1000, PDO_FIXED_DATA_SWAP | PDO_FIXED_USB_COMM | PDO_FIXED_EXTPOWER | PDO_FIXED_DUAL_ROLE)>;
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_DATA_SWAP | PDO_FIXED_USB_COMM | PDO_FIXED_EXTPOWER | PDO_FIXED_DUAL_ROLE)>;
		};
	};

	/* ===== OV13855 on CSI1 (J15)，默认关闭，由 overlay 打开 ===== */
	ov13855_csi1: ov13855-csi1@10 {
		compatible = "ovti,ov13855";
		status = "disabled";
		reg = <0x10>;
		clocks = <&cru REF_CLK0_OUT_PLL>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&ref_clk0_clk0_pins &csi1_reset>;
		reset-gpios = <&gpio1 RK_PC2 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "RK-CMK-8M-2-v1";
		rockchip,camera-module-lens-name = "CK8401";

		port {
			ov13855_csi1_out0: endpoint {
				remote-endpoint = <&mipi_in_ov13855_csi1>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

/* I2C4_M3：引出到 EXPORT2 (SDA=GPIO3_B7 / SCL=GPIO3_C0) */
&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m3_xfer_pins>;
	clock-frequency = <100000>;
	status = "okay";
};

/*
 * I2C6(m0)：
 *  - ES8390 音频 codec (0x11)
 *  - GT911 电容触摸屏 (0x5d)
 *  - OV13855 摄像头 @ CSI2 (J16, 0x10)
 */
&i2c6 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6m0_xfer_pins>;

	es8390: es8390@11 {
		status = "okay";
		#sound-dai-cells = <0>;
		compatible = "everest,es8389";
		reg = <0x11>;
		clocks = <&mclkout_sai0>;
		clock-names = "mclk";
		assigned-clocks = <&mclkout_sai0>;
		assigned-clock-rates = <12288000>;
		pinctrl-names = "default";
		pinctrl-0 = <&sai0m1_mclk_pins>;
	};

	/* GT911 电容触摸（MIPI LCD），默认关闭，由 overlay 打开 */
	gt911: touchscreen@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		status = "disabled";
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PC4 IRQ_TYPE_EDGE_FALLING>;	/* GPIO2_C4: MIPI_DSI_CAP_TS_nINT */
		pinctrl-names = "default";
		pinctrl-0 = <&gt911_int>;
	};

	/* ===== OV13855 on CSI2 (J16)，默认关闭，由 overlay 打开 ===== */
	ov13855_csi2: ov13855-csi2@10 {
		compatible = "ovti,ov13855";
		status = "disabled";
		reg = <0x10>;
		clocks = <&cru CAM_CLK1_OUT_IOUT>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk1m0_clk1_pins>;
		reset-gpios = <&gpio2 RK_PB1 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "RK-CMK-8M-2-v1";
		rockchip,camera-module-lens-name = "CK8401";

		port {
			ov13855_csi2_out0: endpoint {
				remote-endpoint = <&mipi_in_ov13855_csi2>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

