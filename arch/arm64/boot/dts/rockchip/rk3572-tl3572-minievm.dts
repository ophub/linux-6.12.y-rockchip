/* 调高 littlecore 温度保护门限 */
&littlecore_thermal {
	trips {
		threshold: trip-point-0 {
			temperature = <115000>;
			hysteresis = <2000>;
			type = "passive";
		};

		target: trip-point-1 {
			temperature = <115000>;
			hysteresis = <2000>;
			type = "passive";
		};

		littlecore_crit: littlecore-crit {
			/* millicelsius */
			temperature = <115000>;
			/* millicelsius */
			hysteresis = <2000>;
			type = "critical";
		};
	};
};

&mdio0 {
	rgmii_phy_0: phy@0 {
		/* MaxIO MAE0621A/B-Q3C(I) Gigabit Ethernet */
		compatible = "ethernet-phy-id7b74.4412";
		reg = <0x0>;
		clocks = <&cru REFCLKO25M_GMAC0_OUT>;

		/* LED1: Yellow */
		maxio,led1-triggers = "activity";
		/* LED2: Green */
		maxio,led2-triggers = "link-10", "link-100", "link-1000";

		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&gpio0 RK_PC1 GPIO_ACTIVE_LOW>;
	};
};

&mdio1 {
	rgmii_phy_1: phy@1 {
		/* MaxIO MAE0621A/B-Q3C(I) Gigabit Ethernet */
		compatible = "ethernet-phy-id7b74.4412";
		reg = <0x1>;
		clocks = <&cru REFCLKO25M_GMAC1_OUT>;

		/* LED1: Yellow */
		maxio,led1-triggers = "activity";
		/* LED2: Green */
		maxio,led2-triggers = "link-10", "link-100", "link-1000";

		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_LOW>;
	};
};

/* MIPI CSI2 */
&mipi0_csi2 {
	status = "disabled";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy0_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in0>;
			};
		};
	};
};

&mipi2_csi2 {
	status = "disabled";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi2_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy3_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi2_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi3_in0>;
			};
		};
	};
};

&mipitx_dphy {
	status = "okay";
};

&mpp_srv {
	status = "okay";
};

/*
 * PCIe1：EXPORT1 导出（PCIE1_REFCLK + PCIE1_TX/RX 差分对），使能供外接 PCIe 设备使用。
 * PCIe1 复位（PERST#）引脚说明：
 * 官方原理图未定义 PCIe1 专用复位信号，EXPORT1/EXPORT2 也未引出 PERST#。
 * 若需对 EXPORT1 外接的 PCIe 卡做硬件复位，可在下列空闲 GPIO 中任选一个飞线到卡的
 * PERST#（低有效），再于本节点补 reset-gpios = <&gpioX RK_PYn GPIO_ACTIVE_LOW>。
 *
 * EXPORT1(CON13, 30pin) 可作 PERST# 的 GPIO —— 注意它们同时是 EXPORT1 的复用引脚，
 * 本 base 的“默认组合”已占用其中 7 个（见文件头 EXPORT 说明），要用须先关闭对应总线：
 *   pin 9  = GPIO1_D5 (AR18) 1V8  ← 默认 CAN3_TX    （已占用）
 *   pin 11 = GPIO1_D6 (1AF7) 1V8  ← 默认 CAN3_RX    （已占用）
 *   pin 15 = GPIO2_B5 (B4)   3V3  ← 默认 UART2_TX   （已占用）
 *   pin 17 = GPIO2_B4 (1B2)  3V3  ← 默认 UART2_RX   （已占用）
 *   pin 19 = GPIO2_B6 (1D3)  3V3  ← 默认 UART2_RTS  （已占用）
 *   pin 25 = GPIO4_B7 (AN32) 3V3  ← 默认 CAN1_RX    （已占用）
 *   pin 27 = GPIO4_B6 (AP33) 3V3  ← 默认 CAN1_TX    （已占用）
 *   ★ pin 23 = GPIO2_D0 (A8) 3V3  ← 默认空闲，推荐作 PERST# 首选（3V3、无需改总线）
 *   注：叠加 export1-spdif.dtbo 会再占用 pin9/11；export1-sai1.dtbo 会再占用 pin15/19。
 *   EXPORT1 其余引脚：1=VDD_5V_IO, 2=VDD_3V3_IO, 28=RK806S_PWRON,
 *   6/8=PCIE1_REFCLK, 12/14=PCIE1_TX, 18/20=PCIE1_RX, 其余为 GND。
 *
 * EXPORT2(CON14, 30pin) 全部为通用 GPIO（3V3），可作 PERST# 备选：
 *   默认组合已占用 pin 5/7/11/13/14/15/16/18/19/21/23/27/28/30；
 *   默认仍空闲、可直接作 PERST# 的引脚：
 *     pin 6 =GPIO3_A5  8 =GPIO3_A6  10=GPIO3_D3  12=GPIO3_B5
 *     pin 17=GPIO3_A7  24=GPIO3_B6  25=GPIO3_B4  26=GPIO3_D6
 *   （叠加替代 overlay 后占用会变化，详见文件头 EXPORT 说明与各 overlay。）
 *   EXPORT2 其余引脚：1=VDD_5V_IO, 2=VDD_3V3_IO, 3/4/9/20/22/29=GND。
 *
 * 电平：标准 PCIe 卡 PERST# 为 3.3V 低有效，优先选 3V3 域 GPIO；
 *   EXPORT1 的 pin9/pin11(GPIO1_D5/D6) 属 1V8 域，驱动 3.3V PERST# 需加电平转换。
 *
 * SoC 端 pcie1 已含 CRU 内部复位（SRST_RESETN_PCIE1_POWER_UP / SRST_PRESETN_PCIE1），
 * 无外部 PERST 亦可正常枚举，故默认不添加 reset-gpios。
 */
&pcie1 {
	rockchip,skip-scan-in-resume;
	status = "disabled";
};

&pinctrl {
	pinctrl-names = "default";

	backlight_pins {
		bl_en_pins: bl-en-pins {
			rockchip,pins = <2 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	csi_resetpins {
		csi1_reset: csi1-reset {
			rockchip,pins = <1 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		csi2_reset: csi2-reset {
			rockchip,pins = <2 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	headphone {
		hp_con: hp-con {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		hp_det: hp-det {
			rockchip,pins = <4 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	leds {
		som_led: som-led {
			rockchip,pins = <0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		user_led1: user-led1 {
			rockchip,pins = <0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		user_led2: user-led2 {
			rockchip,pins = <4 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	touch {
		gt911_int: gt911-int {
			rockchip,pins = <2 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		usbc0_int: usbc0-int {
			rockchip,pins = <2 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&reserved_memory {
	/* CMA: 256MB */
	cma: cma {
		compatible = "shared-dma-pool";
		reusable;
		size = <0x0 (256 * 0x100000)>;
		linux,cma-default;
	};

	drm_logo: drm-logo@0 {
		compatible = "rockchip,drm-logo";
		reg = <0x0 0x0 0x0 0x0>;
	};

	drm_cubic_lut: drm-cubic-lut@0 {
		compatible = "rockchip,drm-cubic-lut";
		reg = <0x0 0x0 0x0 0x0>;
	};

	ramoops: ramoops@40110000 {
		compatible = "ramoops";
		/* 0x40110000 to 0x401f0000 is for ramoops */
		reg = <0x0 0x40110000 0x0 0xe0000>;
		boot-log-size = <0x8000>;	/* do not change */
		boot-log-count = <0x1>;		/* do not change */
		console-size = <0x80000>;
		pmsg-size = <0x30000>;
		ftrace-size = <0x00000>;
		record-size = <0x14000>;
	};
};

&rga2_core0 {
	status = "okay";
};

&rga2_core0_mmu {
	status = "okay";
};

/* CIF：默认关闭，由 overlay (rk3572-tl3572-minievm-camera-csi1/csi2.dtso) 打开 */
&rkcif {
	status = "disabled";
};

&rkcif_mipi_lvds {
	status = "disabled";
	port {
		cif_mipi_in0: endpoint {
			remote-endpoint = <&mipi0_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds2 {
	status = "disabled";
	port {
		cif_mipi3_in0: endpoint {
			remote-endpoint = <&mipi2_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds2_sditf {
	status = "disabled";
	port {
		mipi_lvds3_sditf: endpoint {
			remote-endpoint = <&isp_vir0_in1>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "disabled";
	port {
		mipi_lvds_sditf: endpoint {
			remote-endpoint = <&isp_vir0_in0>;
		};
	};
};

&rkcif_mmu {
	status = "disabled";
};

/* ISP：默认关闭，由 overlay (rk3572-tl3572-minievm-camera-csi1/csi2.dtso) 打开 */
&rkisp {
	status = "disabled";
	isp-supply = <&vdd_logic_s0>;
};

&rkisp_mmu {
	status = "disabled";
};

&rkisp_vir0 {
	status = "disabled";
	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir0_in0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds_sditf>;
		};

		isp_vir0_in1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&mipi_lvds3_sditf>;
		};
	};
};

&rkisp_vir0_sditf {
	status = "disabled";
};

&rknpu {
	rknpu-supply = <&vdd_npu_s0>;
	status = "okay";
};

&rknpu_mmu {
	status = "okay";
};

&rkvdec {
	status = "okay";
};

&rkvdec_mmu {
	status = "okay";
};

&rkvenc {
	status = "okay";
};

&rkvenc_mmu {
	status = "okay";
};

&rkvpss {
	status = "disabled";
};

&rkvpss_mmu {
	status = "disabled";
};

&rkvpss_vir0 {
	status = "disabled";
};

&rng {
	status = "okay";
};

&rockchip_suspend {
	status = "okay";
	rockchip,sleep-debug-en = <1>;
	rockchip,sleep-io-ret-config = <
		(0
		| RKPM_VCCIO3_RET_EN
		)
	>;
	rockchip,sleep-pin-config = <(0) (0)>;
};

/* DSI 路由，默认关闭，由 overlay 打开 */
&route_dsi {
	connect = <&vp1_out_dsi>;
	status = "disabled";
};

&route_hdmi {
	status = "okay";
	connect = <&vp0_out_hdmi>;
};

/* SAI0_M1：音频接口 */
&sai0 {
	status = "okay";
	/delete-property/ pinctrl-0;
	pinctrl-names = "default";
	pinctrl-0 = <&sai0m1_lrck_pins
		     &sai0m1_sclk_pins
		     &sai0m1_sdi0_pins
		     &sai0m1_sdo0_pins>;
};

&sai4 {
	status = "okay";
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
};

&saradc {
	status = "okay";
	vref-supply = <&vccio_1v8_s0>;
};

&sdhci {
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	max-frequency = <200000000>;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	full-pwr-cycle-in-suspend;
	status = "okay";
};

&sdmmc0 {
	max-frequency = <200000000>;
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc3v3_sd_s0>;
	vqmmc-supply = <&vccio_sd_s0>;
	status = "okay";
};

/* SPI1_M2：4-wire，引出到 EXPORT2 pin11/13/14/15 */
&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1m2_pins &spi1m2_csn0_pins>;
	status = "okay";

	spidev@0 {
		compatible = "rockchip,spidev";
		reg = <0>;
		spi-max-frequency = <10000000>;
		status = "okay";
	};
};

/* SPI4_M1：XPT2046 电阻触摸控制器 */
&spi4 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi4m1_pins &spi4m1_csn1_pins>;
	status = "okay";

	xpt2046: touchscreen@1 {
		compatible = "ti,ads7846";
		reg = <1>;
		status = "disabled";
		spi-max-frequency = <2000000>;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PA4 IRQ_TYPE_EDGE_FALLING>;
		pendown-gpios = <&gpio3 RK_PA4 GPIO_ACTIVE_LOW>;
		ti,x-min = /bits/ 16 <0>;
		ti,x-max = /bits/ 16 <4095>;
		ti,y-min = /bits/ 16 <0>;
		ti,y-max = /bits/ 16 <4095>;
		ti,x-plate-ohms = /bits/ 16 <100>;
		ti,pressure-max = /bits/ 16 <255>;
		linux,gpio-keymap = <KEY_ESC>;
	};
};

&tsadc {
	status = "okay";
};

&u2phy0 {
	orientation-switch;
	status = "okay";
};

&u2phy0_otg {
	rockchip,typec-vbus-det;
	status = "okay";
};

&u2phy1 {
	status = "okay";
};

/* USB3.0 Host：无 VBUS 供电控制，去掉 phy-supply */
&u2phy1_otg {
	status = "okay";
};

/* UART10_M0（EXPORT2 pin19 RX / pin21 TX） */
&uart10 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart10m0_xfer_pins>;
	status = "okay";
};

/* UART2_M1（EXPORT1 pin15 TX / pin17 RX） */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m1_xfer_pins>;
	status = "okay";
};

/* UART3_M1（EXPORT2 pin23 TX / pin27 RX） */
&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart3m1_xfer_pins>;
	status = "okay";
};

/* UART4_M0：路由到 EXPORT2 pin28(RX)/pin30(TX) */
&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart4m0_xfer_pins>;
	status = "okay";
};

/* UART5_M0（EXPORT2 pin5 TX / pin7 RX） */
&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart5m0_xfer_pins>;
	status = "okay";
};

/*
 * UFS：由 SOM-TL3572-S 引出（原理图 SOM CONNECTOR CON0 pin222~231：
 *   UFS_TX_D0/D1、UFS_RX_D0/D1、UFS_REFCLK、UFS_RSTN），
 * 且模组默认从 UFS 启动（P5 BOOT MODE CONFIG 的 Config7：UFS->USB，S1100 ON）。
 * reset 脚 UFS_RSTN = GPIO4_C0
 * MiniEVM板并未引出UFS，故不使能。
 */
&ufs {
	reset-gpios = <&gpio4 RK_PC0 GPIO_ACTIVE_HIGH>;
	status = "disabled";
};

/* USB3.0 DRD0：Type-C，OTG */
&usb_drd0_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
	status = "okay";
};

/* USB3.0 DRD1：USB3.0 Host */
&usb_drd1_dwc3 {
	dr_mode = "host";
	/* USB3.0 SuperSpeed：加入 USB3 PHY */
	phys = <&u2phy1_otg>, <&combphy1_psu PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	snps,dis_u2_susphy_quirk;
	snps,usb2-lpm-disable;
	status = "okay";
};

&vdpp {
	status = "okay";
};

&vop {
	status = "okay";
	rockchip,disable-afbc-mask = <(1 << ROCKCHIP_VOP2_CLUSTER1)>;
};

&vop_mmu {
	status = "okay";
};
